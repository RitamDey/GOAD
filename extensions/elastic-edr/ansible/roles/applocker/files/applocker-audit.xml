<?xml version="1.0" encoding="utf-8"?>
<!--
  GOAD elastic-edr extension - AppLocker AUDIT-ONLY policy.

  This policy gathers AppLocker audit telemetry without enforcing blocks.
  Every configured RuleCollection uses EnforcementMode="AuditOnly".

  Coverage is deliberately explicit:
    - EXE and Script: Everyone may run files under Windows and Program Files;
      BUILTIN\Administrators may run all files.
    - MSI: Everyone may run signed installers and installers under the Windows
      Installer directory; BUILTIN\Administrators may run all installer files.
    - Appx: Everyone may run signed packaged apps.
  Other candidates are audited, not blocked. This is a learning-lab signal
  policy, not an application-control allow-list.

  Removal is handled by the extension uninstall playbook.
-->
<AppLockerPolicy Version="1">
  <RuleCollection Type="Exe" EnforcementMode="AuditOnly">
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E101}" Name="Everyone - Windows folder" Description="Audit-only baseline path allow" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions><FilePathCondition Path="%WINDIR%\*"/></Conditions>
    </FilePathRule>
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E102}" Name="Everyone - Program Files" Description="Audit-only baseline path allow" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions><FilePathCondition Path="%PROGRAMFILES%\*"/></Conditions>
    </FilePathRule>
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E103}" Name="Administrators - all executable paths" Description="Default administrator path allow" UserOrGroupSid="S-1-5-32-544" Action="Allow">
      <Conditions><FilePathCondition Path="*"/></Conditions>
    </FilePathRule>
  </RuleCollection>
  <RuleCollection Type="Msi" EnforcementMode="AuditOnly">
    <FilePublisherRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E201}" Name="Everyone - signed installers" Description="Audit-only publisher allow for signed installers" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePublisherCondition PublisherName="*" ProductName="*" BinaryName="*">
          <BinaryVersionRange LowSection="0.0.0.0" HighSection="*"/>
        </FilePublisherCondition>
      </Conditions>
    </FilePublisherRule>
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E202}" Name="Everyone - Windows Installer directory" Description="Default Windows Installer path allow" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions><FilePathCondition Path="%WINDIR%\Installer\*"/></Conditions>
    </FilePathRule>
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E203}" Name="Administrators - all installer paths" Description="Default administrator installer allow" UserOrGroupSid="S-1-5-32-544" Action="Allow">
      <Conditions><FilePathCondition Path="*"/></Conditions>
    </FilePathRule>
  </RuleCollection>
  <RuleCollection Type="Script" EnforcementMode="AuditOnly">
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E301}" Name="Everyone - Windows scripts" Description="Audit-only baseline path allow" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions><FilePathCondition Path="%WINDIR%\*"/></Conditions>
    </FilePathRule>
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E302}" Name="Everyone - Program Files scripts" Description="Audit-only baseline path allow" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions><FilePathCondition Path="%PROGRAMFILES%\*"/></Conditions>
    </FilePathRule>
    <FilePathRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E303}" Name="Administrators - all script paths" Description="Default administrator script allow" UserOrGroupSid="S-1-5-32-544" Action="Allow">
      <Conditions><FilePathCondition Path="*"/></Conditions>
    </FilePathRule>
  </RuleCollection>
  <RuleCollection Type="Appx" EnforcementMode="AuditOnly">
    <FilePublisherRule Id="{A8DFB7A7-2C0B-4EC3-A2E1-1D9A4F46E401}" Name="Everyone - signed packaged apps" Description="Default packaged-app publisher allow" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePublisherCondition PublisherName="*" ProductName="*" BinaryName="*">
          <BinaryVersionRange LowSection="0.0.0.0" HighSection="*"/>
        </FilePublisherCondition>
      </Conditions>
    </FilePublisherRule>
  </RuleCollection>
</AppLockerPolicy>
